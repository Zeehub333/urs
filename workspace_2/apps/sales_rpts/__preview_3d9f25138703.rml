  <columns>
    <column id="1" name="col_1" alias="رمز الصنف" expr="=[I_CODE]" join_type="one_to_one" icon="fa-hashtag" distinct="1"/>
    <column id="2" name="col_2" alias="اسم الصنف" expr="=[16.IAS_ITM_MST.I_NAME]" join_type="one_to_one" icon="fa-hashtag"/>
    <column id="3" name="col_3" alias="التسعير" expr="=IF(@priceMethod=o1,[I_PRICE] ,[PRIMARY_COST] )" join_type="one_to_one" icon="fa-hashtag" color="#d400ff" weight="bold" is_amount="1" currency_symbol="$" is_status="1"/>
    <column id="4" name="col_4" alias="نسبة خطة العينات" expr="=$plan_config.sample_avg$" join_type="one_to_one" icon="fa-hashtag"/>
    <column id="5" name="col_5" alias="الكمية" expr="" join_type="one_to_one" icon="fa-hashtag"/>
    <column id="6" name="col_6" alias="البونص" expr="" join_type="one_to_one" icon="fa-hashtag"/>
    <column id="7" name="col_7" alias="القيمة" expr="" join_type="one_to_one" icon="fa-hashtag"/>
  </columns>
  <links>
    <link id="1" from_table="IAS_ITM_MST" from_col="I_CODE" to_table="IAS_ITEM_PRICE" to_col="I_CODE" rel_type="one_to_one"/>
    <link id="2" from_table="IAS_BILL_DTL" from_col="BILL_NO" to_table="IAS_BILL_MST" to_col="BILL_NO" rel_type="one_to_many"/>
    <link id="3" from_table="IAS_BILL_DTL" from_col="I_CODE" to_table="IAS_ITM_MST" to_col="I_CODE" rel_type="one_to_many"/>
  </links>
  <table_opts>
    <table name="IAS_ITM_MST" conn="16" is_default="1"/>
    <table name="IAS_ITEM_PRICE" conn="16"/>
    <table name="IAS_BILL_DTL" conn="16"/>
    <table name="IAS_BILL_MST" conn="16"/>
  </table_opts>
  <groups>
    <group id="1" name="بيانات الصنف" order="1">
      <column alias="رمز الصنف"/>
      <column alias="اسم الصنف"/>
      <column alias="سعر البيع"/>
      <column alias="سعر التكلفة"/>
      <column alias="عمود 4"/>
      <column alias="سعر البيع الاقصى"/>
      <column alias="التسعير"/>
      <column alias="نسبة خطة العينات"/>
    </group>
    <group id="2" name="صافي المبيعات" order="2" color="#ffffff" bg="#006eff">
      <column alias="القيمة"/>
      <column alias="البونص"/>
      <column alias="الكمية"/>
    </group>
  </groups>
  <doc_params>
    <doc_param column="priceMethod" id="dp_custom_1791365971394" label="طريقة التسعيرة" type="select" op="equals" required="1" default_value="o1" param_refname="priceMethod" is_custom="1" no_filter="1">
      <option name="o1" value="بالبيع">بالبيع</option>
      <option name="o2" value="بالتكلفة">بالتكلفة</option>
    </doc_param>
  </doc_params>
  <general_where>([IAS_ITM_MST.G_CODE] &lt;&gt; '9000' AND [IAS_ITM_MST.G_CODE] &lt;&gt; '9200') AND ([IAS_ITEM_PRICE.LEV_NO] = 1 AND [IAS_ITEM_PRICE.I_PRICE] &lt;&gt; 0) AND ([IAS_BILL_DTL.CC_CODE] = '11')</general_where>
</rml>