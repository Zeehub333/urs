<?xml version="1.0" encoding="utf-8"?>
<rml>
  <rpt_metadata name="__palette_preview__" displayName="معاينة اللوحة" category="preview" schema="IAS20264" icon="fa-table" type="doc" doc_layout="table" connection="ORCL_PROD" namespace="p"/>
  <rml_connections>
    <connection id="1" connection_id="16"/>
  </rml_connections>
  <rules>
    <rule id="1" name="plan_config" display="تهيئة خطط العينات" connection_id="16">
      <sources>
        <source field="I_NAME"/>
      </sources>
      <variables>
        <variable name="sample_avg" display="نسبة العينات" type="number"/>
      </variables>
      <policies>
        <policy id="p1" name="5%" priority="100">
          <match>
            <on field="I_NAME">
              <v>اكوابانت 40 مجم فيال</v>
              <v>هيسون اكوى  100مجم فيال</v>
              <v>اينوكسابارين تعافي 4000 ملجم  2 حقنة</v>
              <v>اينوكسابارين تعافي 6000 ملجم  2 حقنة</v>
              <v>افلودوز اكس ار  1 ش * 10</v>
              <v>I_NAME</v>
              <v>بايوبينيم 1جم فيال</v>
              <v>بايوسيفيكسيم 100ملج 60 ML شراب</v>
              <v>بايوسيفيكسيم 400 ملح 6 كبسول</v>
              <v>بايوكسون 1جم فيال</v>
              <v>بيوكسيغا  10 ملج 2ش * 14 قرص</v>
              <v>بيوكسيغا 5 ملج  2ش * 14 قرص</v>
              <v>جاسكيور  200 ملج شراب</v>
              <v>جنتازون كريم 30جرام</v>
              <v>سيتا فيا بلاس 1000/50 ملج  8 ش *7قرص</v>
              <v>فاليستو  50 ملج  2ش * 14 قرص</v>
              <v>فاليستو 100 ملج  2ش * 14 قرص</v>
              <v>فوربيم 1جم فيال</v>
              <v>ميوفيكس 150ملج  2ش * 10 قرص</v>
            </on>
          </match>
          <values>
            <v name="sample_avg">5</v>
          </values>
        </policy>
        <policy id="p2" name="10%" priority="100">
          <match>
            <on field="I_NAME">
              <v>I_NAME</v>
              <v>ميراكوى 1جم فيال</v>
              <v>اكواسيبام 500/500 مجم فيال</v>
              <v>تازوبيرث 4.5 جم فيال</v>
              <v>اكلاف 1.2 جم فيال</v>
              <v>بريدتش  40 مجم فيال</v>
              <v>افسيناف 1جم فيال</v>
              <v>سيفيبيم اكوا 1جم فيالة</v>
              <v>تافيديم 1جم فيال</v>
              <v>اوكسيريم 750 ملج فياله</v>
              <v>اكوابرازون 1جم فيال</v>
              <v>اكواراب 20 مجم فيال</v>
              <v>اوسترا راف  200 ملج شراب</v>
              <v>ازيرفين  500 ملج 3 ق</v>
              <v>اكسوراف 2.5 ملج 3ش * 10ق</v>
              <v>اكسوراف 15 ملج 3ش * 10ق</v>
              <v>فوليراف بلس  2ش * 10 ق</v>
              <v>كابيراف  0.5 ملج 4 ق</v>
              <v>ايتامراف 500 ملج  2ش * 10 ق</v>
              <v>بونماك راف  4*5  ملج شراب</v>
              <v>بونماك راف 4 ق</v>
              <v>نيترو راف 100ملج 2ش * 10 ق</v>
              <v>رابيجاست 20ملجم 3ش*10ق</v>
              <v>اف اف زد علب 30قرص</v>
              <v>فرت فل 50ملجم 1ش*10ق</v>
              <v>كالسينيوم زد دي3 اقراص 2ش*15ق</v>
              <v>اوندون اقراص 500ملجم 3ش*10ق</v>
              <v>زولكس 8 ملجم - 20 قرص</v>
              <v>فيلتكس 50 ملجم - 30 قرص</v>
              <v>ليفوتكس 5 ملجم - 10 قرص</v>
              <v>تكساب 90 ملجم - 14 قرص</v>
              <v>تكساب 120 ملجم - 7 قرص</v>
              <v>اوندون اقراص 500ملجم 1ش*10ق</v>
            </on>
          </match>
          <values>
            <v name="sample_avg">10</v>
          </values>
        </policy>
      </policies>
    </rule>
  </rules>
