  <fields>
    <field id="1" name="I_NAME" type="VARCHAR" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="2" name="I_CODE" type="VARCHAR" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="3" name="ITM_UNT" type="VARCHAR" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="4" name="SELLING_PRICE" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="5" name="COST_PRICE" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="6" name="SALES_QTY" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="7" name="SALES_BONUS" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="8" name="SALES_VAL" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="9" name="ACTUAL_QTY" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="10" name="ACTUAL_BONUS" type="NUMERIC" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="11" name="BILL_DATE" type="DATE" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="12" name="BRN_NO" type="INTEGER" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="13" name="CUST_TYPE" type="VARCHAR" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
    <field id="14" name="PAY_TYPE" type="VARCHAR" conn_id="16" table_source="VW_SAMPLE_PLAN_CTRL"/>
  </fields>
  <columns>
    <column id="1" name="col_i_name" alias="اسم الصنف" expr="=[I_NAME]" join_type="one_to_one" icon="fa-pills"/>
    <column id="2" name="col_i_code" alias="رقم الصنف" expr="=[I_CODE]" join_type="one_to_one" icon="fa-hashtag" distinct="1"/>
    <column id="3" name="col_itm_unt" alias="الوحدة" expr="=[ITM_UNT]" join_type="one_to_one" icon="fa-box"/>
    <column id="4" name="col_pricing" alias="التسعير" expr="=IF(@priceMethod='cost', [COST_PRICE], [SELLING_PRICE])" join_type="one_to_one" icon="fa-tag" is_amount="1"/>
    <column id="5" name="col_sales_qty" alias="صافي كمية المبيعات" expr="=SUM([SALES_QTY])" col_type="aggregated" join_type="one_to_one" icon="fa-cart-shopping" is_amount="1"/>
    <column id="6" name="col_sales_bonus" alias="بونص المبيعات" expr="=SUM([SALES_BONUS])" col_type="aggregated" join_type="one_to_one" icon="fa-gift" is_amount="1"/>
    <column id="7" name="col_sales_val" alias="قيمة المبيعات" expr="=SUM([SALES_VAL])" col_type="aggregated" join_type="one_to_one" icon="fa-money-bill-wave" is_amount="1"/>
    <column id="16" name="col_16" alias="نسبة" expr="=IF(@p_category='1', $plan_rates.sample_pct$, IF(@custType='wholesale', $bounus_rates.q2_b_rate$, $bounus_rates.q1_b_rate$))" join_type="one_to_one" icon="fa-hashtag" hide_blank="1" hide_zero="1"/>
    <column id="8" name="col_plan_qty" alias="كمية الخطة" expr="=ROUND([col_sales_qty] * ([col_16] / 100), 2)" col_type="computed" join_type="one_to_one" icon="fa-calculator" is_amount="1"/>
    <column id="9" name="col_plan_val" alias="قيمة الخطة" expr="=ROUND([col_plan_qty] * [col_pricing], 2)" col_type="computed" join_type="one_to_one" icon="fa-coins" is_amount="1"/>
    <column id="10" name="col_act_pct" alias="النسبة الفعلية %" expr="=IF([col_sales_qty] &gt; 0, ROUND(([col_act_qty] / [col_sales_qty]) * 100, 2), 0)" col_type="computed" join_type="one_to_one" icon="fa-percent"/>
    <column id="11" name="col_act_qty" alias="الكمية الفعلية" expr="=SUM([ACTUAL_QTY])" col_type="aggregated" join_type="one_to_one" icon="fa-clipboard-check" is_amount="1"/>
    <column id="12" name="col_act_val" alias="القيمة الفعلية" expr="=ROUND([col_act_qty] * [col_pricing], 2)" col_type="computed" join_type="one_to_one" icon="fa-sack-dollar" is_amount="1"/>
    <column id="13" name="col_dev_pct" alias="انحراف النسبة %" expr="=ROUND([col_16] - [col_act_pct], 2)" col_type="computed" join_type="one_to_one" icon="fa-percent"/>
    <column id="14" name="col_dev_qty" alias="انحراف الكمية" expr="=[col_plan_qty] - [col_act_qty]" col_type="computed" join_type="one_to_one" icon="fa-arrows-split-up-and-left" is_amount="1"/>
    <column id="15" name="col_dev_val" alias="انحراف القيمة" expr="=[col_plan_val] - [col_act_val]" col_type="computed" join_type="one_to_one" icon="fa-scale-unbalanced" is_amount="1"/>
  </columns>
  <table_opts>
    <table name="VW_SAMPLE_PLAN_CTRL" conn="16" is_default="1" where_match="all"/>
  </table_opts>
  <groups>
    <group id="1" name="بيانات الصنف" order="1" bg="#f8fafc">
      <column alias="col_i_name"/>
      <column alias="col_i_code"/>
      <column alias="col_itm_unt"/>
      <column alias="col_pricing"/>
    </group>
    <group id="2" name="صافي المبيعات" order="2" bg="#eff6ff">
      <column alias="col_sales_qty"/>
      <column alias="col_sales_bonus"/>
      <column alias="col_sales_val"/>
    </group>
    <group id="3" name="الخطة" order="3" bg="#fefce8">
      <column alias="col_plan_qty"/>
      <column alias="col_plan_val"/>
      <column alias="عمود 16"/>
      <column alias="نسبة"/>
    </group>
    <group id="4" name="الفعلي" order="4" bg="#f0fdf4">
      <column alias="col_act_pct"/>
      <column alias="col_act_qty"/>
      <column alias="col_act_val"/>
    </group>
    <group id="5" name="الانحراف" order="5" bg="#fef2f2">
      <column alias="col_dev_pct"/>
      <column alias="col_dev_qty"/>
      <column alias="col_dev_val"/>
    </group>
  </groups>
  <group_bys>
    <gb field="I_CODE" order="1"/>
    <gb field="I_NAME" order="2"/>
    <gb field="ITM_UNT" order="3"/>
    <gb field="SELLING_PRICE" order="4"/>
    <gb field="COST_PRICE" order="5"/>
  </group_bys>
  <doc_params>
    <doc_param column="branch" id="dp_branch" label="الفرع" type="select" op="equals" required="1" default_value="0" param_refname="branch" src_mode="table" src_conn="16" is_custom="1" no_filter="1" event="filter" src="static">
      <option name="0" value="كافة الفروع">كافة الفروع</option>
      <option name="1" value="الادارة العامة">الادارة العامة</option>
      <option name="1012" value="تعافي فارما - فرع صنعاء">تعافي فارما - فرع صنعاء</option>
      <option name="1022" value="تعافي فارما - فرع ذمار">تعافي فارما - فرع ذمار</option>
      <option name="1032" value="تعافي فارما - فرع إب">تعافي فارما - فرع إب</option>
      <option name="1042" value="تعافي فارما - فرع الحديدة">تعافي فارما - فرع الحديدة</option>
      <option name="1052" value="تعافي فارما - فرع عمران">تعافي فارما - فرع عمران</option>
      <option name="1062" value="تعافي فارما - فرع صعدة">تعافي فارما - فرع صعدة</option>
    </doc_param>
    <doc_param column="BILL_DATE" id="dp_bill_date" label="الفترة" type="date" op="between" required="0" default_value="2026-01-01" src_mode="table" src_conn="16" event="filter" src="input"/>
    <doc_param column="custType" id="dp_cust_type" label="نوع العميل" type="select" op="equals" required="1" default_value="0" param_refname="custType" src_mode="table" src_conn="16" is_custom="1" no_filter="1" event="filter" src="static">
      <option name="0" value="كلي">كلي</option>
      <option name="wholesale" value="جملة">جملة</option>
      <option name="retail" value="تجزئة">تجزئة</option>
    </doc_param>
    <doc_param column="payType" id="dp_pay_type" label="نوع المعاملة" type="select" op="equals" required="1" default_value="0" param_refname="payType" src_mode="table" src_conn="16" is_custom="1" no_filter="1" event="filter" src="static">
      <option name="0" value="كلي">كلي</option>
      <option name="cash" value="نقدي">نقدي</option>
      <option name="credit" value="آجل">آجل</option>
    </doc_param>
    <doc_param column="priceMethod" id="dp_price_method" label="طريقة التسعير" type="select" op="equals" required="1" default_value="cost" param_refname="priceMethod" src_mode="table" src_conn="16" is_custom="1" no_filter="1" event="filter" src="static">
      <option name="cost" value="بالتكلفة">بالتكلفة</option>
      <option name="selling" value="بالبيع">بالبيع</option>
    </doc_param>
    <doc_param column="p_category" id="dp_custom_1791878184052" label="نوع النسبة" type="select" op="equals" required="1" default_value="1" param_refname="p_category" src_mode="table" src_conn="16" is_custom="1" no_filter="1" event="filter" src="static">
      <option name="1" value="نسبة العينات">نسبة العينات</option>
      <option name="2" value="نسبة البونص">نسبة البونص</option>
    </doc_param>
  </doc_params>
  <general_where>(@branch = '0' OR [BRN_NO] = @branch OR (@branch = '1001' AND [BRN_NO] = 1)) AND (@custType = '0' OR [CUST_TYPE] = @custType OR [CUST_TYPE] = '0') AND (@payType = '0' OR [PAY_TYPE] = @payType OR [PAY_TYPE] = '0')</general_where>
</rml>