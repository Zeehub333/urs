<?xml version="1.0" encoding="utf-8"?>
<fml>
  <fml_metadata name="permissions" displayName="صلاحيات المستخدمين" table="ad_permissions" model_type="form" schema="taafi_main_2026" connection="urs_local" category="النظام" icon="fa-shield-halved" description="صلاحيات المستخدمين: نماذج وتقارير وقواعد ومصادر — مصدر محلي أو خارجي" details_tab="التفاصيل"/>
  <tabs>
    <tab id="الصلاحية" name="الصلاحية" alias="الصلاحية" sort_order="1" is_main="1"/>
    <tab id="صلاحيات النماذج" name="صلاحيات النماذج" alias="صلاحيات النماذج" sort_order="2"/>
    <tab id="صلاحيات التقارير" name="صلاحيات التقارير" alias="صلاحيات التقارير" sort_order="3"/>
    <tab id="صلاحيات القواعد" name="صلاحيات القواعد" alias="صلاحيات القواعد" sort_order="4"/>
    <tab id="صلاحيات المصادر" name="صلاحيات المصادر" alias="صلاحيات المصادر" sort_order="5"/>
    <tab id="صلاحيات الحسابات" name="صلاحيات الحسابات" alias="صلاحيات الحسابات" sort_order="6"/>
  </tabs>
  <fields>
    <field id="1" name="perm_source" alias="مصدر الصلاحيات" dataType="VARCHAR" inputType="select" required="true" nullable="false" editable="true" primary_key="false" tab="أساسية" destination="main" category="أساسية">
      <options>
        <option>محلي</option>
        <option>خارجي</option>
      </options>
    </field>
    <field id="2" name="apply_on" alias="تطبيق على :" dataType="VARCHAR" inputType="select" required="false" nullable="true" editable="true" primary_key="false" tab="الصلاحية" destination="main" category="الصلاحية">
      <options>
        <option value="user">المستخدمين</option>
        <option value="group">مجموعات المستخدمين</option>
      </options>
    </field>
    <field id="3" name="user_name" alias="المستخدم" dataType="VARCHAR" inputType="datamodal" required="true" nullable="false" editable="true" primary_key="false" tab="أساسية" destination="main" category="أساسية" src_expr="if(@perm_source='خارجي',[IAS20264.USER_R@16],[taafi_main_2026.users@13])" key_col="taafi_main_2026.users:username,USER_R:u_id" label_col="taafi_main_2026.users:full_name,USER_R:u_a_name"/>
    <field id="4" name="is_active" alias="مفعلة" dataType="BOOLEAN" inputType="boolean" required="false" nullable="true" editable="true" primary_key="false" tab="الحالة" destination="main" category="الحالة"/>
    <field id="5" name="notes" alias="ملاحظات" dataType="TEXT" inputType="textarea" required="false" nullable="true" editable="true" primary_key="false" tab="إضافية" destination="main" category="إضافية"/>
  </fields>
  <details>
    <detail table="ad_perm_forms" alias="صلاحيات النماذج" tab="صلاحيات النماذج" master="id" detail="permission_id" rel_type="one_to_many" link_mode="direct" sub_key="id" visible="1">
      <columns>
        <column name="permission_id" alias="الصلاحية" data_type="INTEGER" input_type="text" tab="الصلاحية"/>
