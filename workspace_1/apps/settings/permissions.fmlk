<?xml version="1.0" encoding="utf-8"?>
<fml>
  <fml_metadata name="permissions" displayName="صلاحيات المستخدمين" table="ad_permissions" model_type="form" schema="main_hq_2026" connection="urs_local" category="النظام" description="صلاحيات المستخدمين: نماذج وتقارير وقواعد ومصادر — مصدر محلي أو خارجي" icon="fa-shield-halved"/>
  <tabs>
    <tab id="main" name="الصلاحية" alias="الصلاحية" sort_order="1"/>
    <tab id="forms" name="صلاحيات النماذج" alias="صلاحيات النماذج" sort_order="2"/>
    <tab id="reports" name="صلاحيات التقارير" alias="صلاحيات التقارير" sort_order="3"/>
    <tab id="rules" name="صلاحيات القواعد" alias="صلاحيات القواعد" sort_order="4"/>
    <tab id="objects" name="صلاحيات المصادر" alias="صلاحيات المصادر" sort_order="5"/>
  </tabs>
  <fields>
    <field id="1" name="perm_source" alias="مصدر الصلاحيات" dataType="VARCHAR" inputType="select" required="true" nullable="false" editable="true" primary_key="false" tab="main" category="أساسية" default="محلي">
      <options>
        <option>محلي</option>
        <option>خارجي</option>
      </options>
    </field>
    <field id="2" name="user_name" alias="المستخدم" dataType="VARCHAR" inputType="datamodal" required="true" nullable="false" editable="true" primary_key="false" tab="main" category="أساسية" src_expr="[ies202601.users@6]" key_col="username" label_col="full_name"/>
    <field id="3" name="is_active" alias="مفعلة" dataType="BOOLEAN" inputType="boolean" required="false" nullable="true" editable="true" primary_key="false" tab="main" category="الحالة" default="true"/>
    <field id="4" name="notes" alias="ملاحظات" dataType="TEXT" inputType="textarea" required="false" nullable="true" editable="true" primary_key="false" tab="main" category="إضافية"/>
  </fields>
  <details>
    <detail table="ad_perm_forms" alias="صلاحيات النماذج" master="id" detail="permission_id" rel_type="one_to_many" sub_key="id" visible="1" link_mode="direct" tab="forms">
      <columns>
        <column name="permission_id" alias="الصلاحية" data_type="INTEGER"/>
        <column name="form_file" alias="ملف النموذج" data_type="VARCHAR"/>
        <column name="form_name" alias="النموذج (بحث بالعربي)" data_type="VARCHAR" src_expr="'ad:forms'"/>
        <column name="can_view" alias="عرض" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_edit" alias="تعديل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_add" alias="اضافة" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_import" alias="استيراد" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_export" alias="تصدير" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_delete" alias="حذف" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_search" alias="بحث" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_migrate" alias="ترحيل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_unmigrate" alias="الغاء الترحيل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="custom_actions" alias="إجراءات مخصصة" data_type="TEXT" input_type="multiselect"/>
        <column name="fields_visibility" alias="ظهور الأعمدة {عمود:0/1}" data_type="TEXT"/>
      </columns>
    </detail>
    <detail table="ad_perm_reports" alias="صلاحيات التقارير" master="id" detail="permission_id" rel_type="one_to_many" sub_key="id" visible="1" link_mode="direct" tab="reports">
      <columns>
        <column name="permission_id" alias="الصلاحية" data_type="INTEGER"/>
        <column name="report_file" alias="ملف التقرير" data_type="VARCHAR"/>
        <column name="report_name" alias="التقرير (بحث بالعربي)" data_type="VARCHAR" src_expr="'ad:reports'"/>
        <column name="can_view" alias="عرض" data_type="BOOLEAN" input_type="boolean"/>
        <column name="columns_visibility" alias="ظهور الأعمدة {عمود:0/1}" data_type="TEXT"/>
      </columns>
    </detail>
    <detail table="ad_perm_rules" alias="صلاحيات القواعد" master="id" detail="permission_id" rel_type="one_to_many" sub_key="id" visible="1" link_mode="direct" tab="rules">
      <columns>
        <column name="permission_id" alias="الصلاحية" data_type="INTEGER"/>
        <column name="rule_file" alias="ملف القاعدة" data_type="VARCHAR"/>
        <column name="rule_name" alias="القاعدة" data_type="VARCHAR" src_expr="'ad:rules'"/>
        <column name="can_view" alias="عرض" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_edit" alias="تعديل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_add" alias="اضافة" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_import" alias="استيراد" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_export" alias="تصدير" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_delete" alias="حذف" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_search" alias="بحث" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_migrate" alias="ترحيل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_unmigrate" alias="الغاء الترحيل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="variables" alias="تفعيل المتغيرات {متغير:0/1}" data_type="TEXT"/>
      </columns>
    </detail>
    <detail table="ad_perm_objects" alias="صلاحيات المصادر" master="id" detail="permission_id" rel_type="one_to_many" sub_key="id" visible="1" link_mode="direct" tab="objects">
      <columns>
        <column name="permission_id" alias="الصلاحية" data_type="INTEGER"/>
        <column name="source" alias="المصدر (مفتاح الدليل)" data_type="VARCHAR"/>
        <column name="ref_key" alias="المرجع (التسلسل)" data_type="VARCHAR"/>
        <column name="ref_name" alias="الاسم" data_type="VARCHAR"/>
        <column name="can_view" alias="عرض" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_edit" alias="تعديل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_add" alias="اضافة" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_import" alias="استيراد" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_export" alias="تصدير" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_delete" alias="حذف" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_search" alias="بحث" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_migrate" alias="ترحيل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="can_unmigrate" alias="الغاء الترحيل" data_type="BOOLEAN" input_type="boolean"/>
        <column name="extra" alias="إضافي" data_type="TEXT"/>
      </columns>
    </detail>
  </details>
</fml>
