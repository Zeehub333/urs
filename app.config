# Odex ERP - local run configuration
# Format: KEY=VALUE (no spaces around =). Lines starting with # are comments.
# run.bat reads this file on every start.

# Python interpreter to use. Examples:
#   PYTHON=python
#   PYTHON=C:\Python313\python.exe
#   PYTHON=C:\Users\admin\Documents\Default Project\urs2\odex\venv\Scripts\python.exe
PYTHON=C:\Users\admin\Documents\Default Project\urs2\odex\venv\Scripts\python.exe

# Django bind address and port
HOST=127.0.0.1
PORT=8004

# Django settings module (SQLite offline fallback; use config.settings for real Postgres)
SETTINGS=config.settings_local

